# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments and Secrets
.env
.env.*
*.key
*.pem
*.token
*.cert
*.pfx
credentials.json
client_secret*.json
.venv
env/
venv/

# IDE and Agent configurations
.vscode/
.idea/
.agents/
*.swp
*.swo

# Scratch & test outputs
*.tmp
temp/
scratch/

# OS artifacts
.DS_Store
Thumbs.db

# Datasets and archives (prevent bloating git)
*.zip
*.tar.gz
ML/data/raw/*
!ML/data/raw/.gitkeep
ML/data/interim/*
!ML/data/interim/.gitkeep
ML/data/processed/*
!ML/data/processed/.gitkeep
!ML/data/processed/dataset_v1.npz
!ML/data/processed/split_manifest_v1.json

